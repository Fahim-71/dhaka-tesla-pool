# Used by docker compose. Copy to .env and change the values.
# Never commit the real .env.

# Postgres container
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teslapool

# API: sign JWTs with a long random string, e.g. from: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# The browser origin allowed to call the API directly (the web container proxies, so this is only for direct calls)
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Host ports
WEB_PORT=8080
API_PORT=4000
