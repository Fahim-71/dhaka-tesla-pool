# Copy to .env for local development (npm run dev). Never commit the real .env.
NODE_ENV=development
PORT=4000
# Local Postgres. With docker compose the api container gets its own value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teslapool
# Any random string of 32+ characters, e.g. from: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
