{
  "name": "dhaka-tesla-pool-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Dhaka Tesla Pool",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
